{
  "_version": "1.53.0",
  "sap.app": {
    "id": "flexspec",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.24.0",
      "toolsId": "46364a02-4c7f-4ea6-9fed-b789f8f7c237"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsb_spec_flex_o4/srvd/sap/zsd_spec_flex/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.114.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "flexspec.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "flexspec.ext.UploadExtension"
          }
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SpecFlexList",
          "target": "SpecFlexList"
        },
        {
          "pattern": "SpecFlex({key}):?query:",
          "name": "SpecFlexObjectPage",
          "target": "SpecFlexObjectPage"
        }
      ],
      "targets": {
        "SpecFlexList": {
          "type": "Component",
          "id": "SpecFlexList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/SpecFlex",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "SpecFlex": {
                  "detail": {
                    "route": "SpecFlexObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "downloadTemplate": {
                      "id": "downloadTemplateBtn",
                      "text": "Download Template",
                      "press": ".extension.flexspec.ext.UploadExtension.onDownloadTemplate",
                      "requiresSelection": false,
                      "enabled": true
                    },
                    "uploadExcel": {
                      "id": "uploadExcelBtn",
                      "text": "Upload from Excel",
                      "press": ".extension.flexspec.ext.UploadExtension.onUploadExcel",
                      "requiresSelection": false,
                      "enabled": true
                    }
                  },
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true,
                    "enablePaste": true
                  }
                }
              }
            }
          }
        },
        "SpecFlexObjectPage": {
          "type": "Component",
          "id": "SpecFlexObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/SpecFlex"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}