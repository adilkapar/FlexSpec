projection;
strict ( 2 );
use draft;

define behavior for ZC_SPEC_FLEX alias SpecFlex
{
  use create;
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action UploadExcel;
  use action SetDeletionFlag;
  use action RemoveDeletionFlag;

  use association _Items { create; with draft; }
}

define behavior for ZC_SPEC_FLEX_ITEM alias SpecFlexItem
{
  use update;
  use delete;

  use association _Header { with draft; }
}