  typeNamePlural: 'Specification Attributes',
  title: { type: #STANDARD, value: 'AttributeId' },
  description: { type: #STANDARD, value: 'AttributeValue' }
}

annotate entity ZC_SPEC_FLEX_ITEM with
{
  /* =========================================================
     FIELD ANNOTATIONS (Item Table in Object Page)
     ========================================================= */

